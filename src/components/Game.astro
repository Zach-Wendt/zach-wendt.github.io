---
// Live Stackelberg security game. Defenders commit to a randomized patrol
// (coverage computed by water-filling, the zero-sum equilibrium); the attacker
// observes coverage and strikes the target with the best expected payoff.
---
<figure class="game">
  <canvas id="game" width="960" height="360" role="img"
    aria-label="Simulation: three blue defenders randomly patrol eight targets while an amber attacker picks the target with the best expected payoff."></canvas>
  <figcaption>
    <p>
      Three defenders guard eight targets; bigger rings are worth more. The shaded arc on each ring is how
      often it gets patrolled. The attacker sees those odds and hits the target with the best expected payoff,
      so the defenders spread coverage until no target is a bargain. This is a Stackelberg security game.
    </p>
    <p class="muted" id="game-score" aria-live="off"></p>
  </figcaption>
</figure>

<style>
  .game { margin: 2.5rem 0 0; }
  canvas {
    display: block; width: 100%; height: auto;
    background: var(--paper); border: 1px solid var(--rule); border-radius: 8px;
  }
  figcaption { margin-top: 1rem; }
  figcaption p { font-size: 0.9375rem; }
</style>

<script>
  const canvas = document.getElementById('game') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const score = document.getElementById('game-score')!;
  const W = canvas.width, H = canvas.height;
  const css = getComputedStyle(document.documentElement);
  const C = {
    ink: css.getPropertyValue('--ink').trim(),
    rule: css.getPropertyValue('--rule').trim(),
    def: css.getPropertyValue('--blue').trim(),
    atk: css.getPropertyValue('--amber').trim(),
  };

  const DEFENDERS = 3;
  const values = [9, 4, 7, 2, 10, 5, 3, 6];
  const spots = [[110, 110], [250, 250], [390, 95], [500, 270], [620, 140], [760, 260], [860, 100], [900, 290]];
  const targets = values.map((v, i) => ({ v, x: spots[i][0], y: spots[i][1], r: 14 + v * 3.2, c: 0 }));

  // Equalize attacker payoff v*(1-c) at threshold t, spending exactly DEFENDERS units of coverage.
  let lo = 0, hi = Math.max(...values);
  for (let k = 0; k < 60; k++) {
    const t = (lo + hi) / 2;
    const used = targets.reduce((s, g) => s + Math.max(0, 1 - t / g.v), 0);
    used > DEFENDERS ? (lo = t) : (hi = t);
  }
  targets.forEach((g) => (g.c = Math.max(0, 1 - hi / g.v)));

  // Comb sampling: exactly DEFENDERS distinct targets, each covered with probability c.
  function samplePatrol() {
    const u = Math.random(), picks: number[] = [];
    let acc = 0;
    targets.forEach((g, i) => {
      const next = acc + g.c;
      for (let k = 0; k < DEFENDERS; k++) if (u + k >= acc && u + k < next) picks.push(i);
      acc = next;
    });
    return picks;
  }
  function attackerChoice() {
    const pay = targets.map((g) => g.v * (1 - g.c));
    const best = Math.max(...pay);
    const ties = pay.flatMap((p, i) => (p > best - 1e-6 ? [i] : []));
    return ties[Math.floor(Math.random() * ties.length)];
  }

  function drawTargets() {
    ctx.clearRect(0, 0, W, H);
    for (const g of targets) {
      ctx.lineWidth = 2;
      ctx.strokeStyle = C.rule;
      ctx.beginPath(); ctx.arc(g.x, g.y, g.r, 0, Math.PI * 2); ctx.stroke();
      if (g.c > 0) {
        ctx.fillStyle = C.def; ctx.globalAlpha = 0.18;
        ctx.beginPath(); ctx.moveTo(g.x, g.y);
        ctx.arc(g.x, g.y, g.r, -Math.PI / 2, -Math.PI / 2 + g.c * Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
      }
      ctx.fillStyle = C.ink; ctx.font = '650 20px "Public Sans Variable", sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(String(g.v), g.x, g.y);
    }
  }
  function dot(x: number, y: number, color: string, r = 8) {
    ctx.fillStyle = color; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
  }

  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    drawTargets();
    score.textContent = 'Animation paused because your system prefers reduced motion.';
  } else {
    const ease = (t: number) => t * t * (3 - 2 * t);
    let rounds = 0, stopped = 0;
    let from = Array.from({ length: DEFENDERS }, (_, k) => [80 + k * 30, H - 30]);
    let round: { patrol: number[]; hit: number; start: number };
    const newRound = (now: number) => (round = { patrol: samplePatrol(), hit: attackerChoice(), start: now });
    newRound(performance.now());

    const ROUND = 2600;
    const frame = (now: number) => {
      const t = (now - round.start) / ROUND;
      drawTargets();
      const move = ease(Math.min(1, t / 0.4));
      round.patrol.forEach((i, k) => {
        const g = targets[i];
        dot(from[k][0] + (g.x - from[k][0]) * move, from[k][1] + (g.y - from[k][1]) * move, C.def);
      });
      const hit = targets[round.hit];
      const caught = round.patrol.includes(round.hit);
      if (t > 0.35) {
        const a = ease(Math.min(1, (t - 0.35) / 0.35));
        const sx = W - 20, sy = 20;
        dot(sx + (hit.x - sx) * a, sy + (hit.y - sy) * a, C.atk, 7);
      }
      if (t > 0.72) {
        ctx.lineWidth = 3; ctx.strokeStyle = caught ? C.def : C.atk;
        ctx.beginPath(); ctx.arc(hit.x, hit.y, hit.r + 6, 0, Math.PI * 2); ctx.stroke();
      }
      if (t >= 1) {
        rounds++; if (caught) stopped++;
        score.textContent = `Round ${rounds}: ${stopped} of ${rounds} attacks stopped (${Math.round((100 * stopped) / rounds)}%).`;
        from = round.patrol.map((i) => [targets[i].x, targets[i].y]);
        newRound(now);
      }
      requestAnimationFrame(frame);
    };
    // rAF pauses in background tabs; restart the round so it doesn't jump on return.
    document.addEventListener('visibilitychange', () => { if (!document.hidden) round.start = performance.now(); });
    requestAnimationFrame(frame);
  }
</script>
